
class Node:
    def __init__(self, roll, name, marks):
        self.roll = roll
        self.name = name
        self.marks = marks
        self.next = None


class StudentList:
    def __init__(self):
        self.head = None

    def add(self, roll, name, marks):
        new_node = Node(roll, name, marks)

        if self.head is None:
            self.head = new_node
        else:
            temp = self.head
            while temp.next:
                temp = temp.next
            temp.next = new_node

        print("Student added successfully")

    def display(self):
        temp = self.head

        if temp is None:
            print("No student records found")
            return

        while temp:
            print(temp.roll, temp.name, temp.marks)
            temp = temp.next

    def delete(self, roll):
        temp = self.head
        prev = None

        while temp:
            if temp.roll == roll:
                if prev is None:
                    self.head = temp.next
                else:
                    prev.next = temp.next

                print("Student deleted successfully")
                return

            prev = temp
            temp = temp.next

        print("Student not found")

    def update(self, roll, name, marks):
        temp = self.head

        while temp:
            if temp.roll == roll:
                temp.name = name
                temp.marks = marks
                print("Student updated successfully")
                return

            temp = temp.next

        print("Student not found")

    def search(self, roll):
        temp = self.head

        while temp:
            if temp.roll == roll:
                print("Student found:", temp.roll, temp.name, temp.marks)
                return

            temp = temp.next

        print("Student not found")

    def sort(self, order):
        students = []
        temp = self.head

        while temp:
            students.append(temp)
            temp = temp.next

        students.sort(key=lambda x: x.marks, reverse=(order == "desc"))

        self.head = None

        for student in students:
            student.next = None

            if self.head is None:
                self.head = student
            else:
                temp = self.head
                while temp.next:
                    temp = temp.next
                temp.next = student

        print("Records sorted successfully")


s = StudentList()

s.add(1, "Amit", 85)
s.add(2, "Rahul", 75)
s.add(3, "Priya", 95)

print("\nStudent Records:")
s.display()

print("\nSearching Student:")
s.search(2)

print("\nUpdating Student:")
s.update(2, "Rahul", 90)

print("\nDeleting Student:")
s.delete(1)

print("\nSorting by Marks in Descending Order:")
s.sort("desc")
s.display()
